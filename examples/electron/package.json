{
  "name": "@xsai-apple-vision/example-electron",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Complete Electron example for xsAI Apple Vision.",
  "author": "Moeru AI",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "pnpm --workspace-root build:native && install-electron && electron-vite dev",
    "package": "pnpm build && electron-builder --dir",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@electron-toolkit/preload": "catalog:",
    "@moeru/eventa": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "@xsai-apple-vision/vision": "workspace:^",
    "@xsai-apple-vision/vision-electron-plugin": "workspace:^",
    "@xsai-apple-vision/vision-native": "workspace:^",
    "@xsai/generate-object": "catalog:",
    "@xsai/stream-text": "catalog:",
    "error-stack-parser": "catalog:",
    "injeca": "catalog:",
    "nanoid": "catalog:",
    "valibot": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "build": {
    "appId": "ai.moeru.xsai-apple-vision.example",
    "productName": "xsAI Apple Vision Example",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@xsai-apple-vision/**/.build/**/*",
      "!node_modules/@xsai-apple-vision/**/native/**/*",
      "!node_modules/@xsai-apple-vision/**/Sources/**/*",
      "!node_modules/@xsai-apple-vision/**/Tests/**/*",
      "!node_modules/@xsai-apple-vision/**/src/**/*",
      "!node_modules/@xsai-apple-vision/vision-native/npm/**/*",
      "!node_modules/@xsai-apple-vision/**/*.test.ts"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": [
        "dir"
      ]
    }
  }
}
