{
  "name": "xsai-apple-vision-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:native": "pnpm --filter @xsai-apple-vision/vision-native build:native",
    "check:clean-install": "bash scripts/check-clean-install.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
